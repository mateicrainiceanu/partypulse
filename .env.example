# Copy this file to .env.local and fill in real values. Never commit .env.local.

# MySQL connection (used by src/app/api/_lib/config/db.ts)
D_HOST=
D_PORT=3306
D_USER=
D_PASS=
D_NAME=

# Auth
# Secret used to sign the app's own JWT session token (src/app/api/_lib/token.ts).
TOKEN_KEY=
# bcrypt salt rounds (src/app/api/_lib/types.ts). Defaults to 10 if unset.
SALT_ROUNDS=10

# NextAuth (required by the next-auth library itself)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth provider
GCLIENT_ID=
GCLIENT_SECRET=

# Spotify OAuth provider + song search
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Outgoing mail (verification / recovery emails)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_SENDERADRESS=

# Misc
HOMEPAGE=http://localhost:3000
NEXT_PUBLIC_GM_API_KEY=
